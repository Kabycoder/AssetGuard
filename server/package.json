{
  "name": "assetguard-server",
  "version": "1.0.0",
  "description": "AssetGuard Backend Service - Secure IT Asset Lifecycle Management Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test:sanitization": "tsx src/scripts/test-sanitization.ts",
    "test:verification": "tsx src/scripts/test-verification.ts",
    "test:dashboard": "tsx src/scripts/test-dashboard.ts",
    "test:e2e": "tsx src/scripts/test-e2e-lifecycle.ts",
    "test:consistency": "tsx src/scripts/test-data-consistency.ts",
    "test:all": "tsx src/scripts/test-sanitization.ts && tsx src/scripts/test-verification.ts && tsx src/scripts/test-dashboard.ts && tsx src/scripts/test-e2e-lifecycle.ts && tsx src/scripts/test-data-consistency.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:direct": "tsx src/scripts/seed-mongo-direct.ts",
    "db:seed:extra": "tsx src/scripts/seed-extra-data.ts",
    "db:init-rs": "tsx src/scripts/init-replica.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "assetguard",
    "asset-disposal",
    "data-wiping",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "rate-limit-redis": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.12.12",
    "prisma": "6.19.3",
    "rimraf": "^5.0.7",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
